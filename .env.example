# Skopiuj ten plik do `.env.local` i uzupełnij.

# Formularze (Kontakt, Rzecznik Praw Studenta, Partnerzy) wysyłają przez Google
# Apps Script na koncie Samorządu — zgłoszenia trafiają do arkusza i na maila,
# a dane nie opuszczają konta Google Uczelni. Instrukcja: docs/WRZUC-TUTAJ.md,
# kod do wklejenia: docs/apps-script/Code.gs.
# Bez tych dwóch zmiennych formularze mówią wprost, że nie są uruchomione,
# i podają adres e-mail — nie udają wysyłki.

# Adres wdrożonej aplikacji internetowej Apps Script (kończy się na /exec).
APPS_SCRIPT_URL=
# Ten sam ciąg co CONFIG.SEKRET w Code.gs. Wygeneruj np.: openssl rand -hex 32
APPS_SCRIPT_SECRET=

# Kalendarz wydarzeń z Google Sheets (CMS). Arkusz → Plik → Udostępnij →
# Opublikuj w internecie → cały dokument, format CSV → wklej tu link.
# Kolumny: nazwa | data (RRRR-MM-DD) | tag. Bez tej zmiennej sekcja NIE
# pokazuje się wcale — świadomie, zamiast wyświetlać zmyślone wydarzenia.
EVENTS_SHEET_CSV_URL=

# Strefa działacza — logowanie Google (OAuth), ograniczone do @samorzad.ue.wroc.pl.
# Utwórz aplikację OAuth w Google Cloud (instrukcja krok po kroku w docs/ENV.md).
# Bez tych zmiennych /strefa-dzialacza pokazuje „Wkrótce".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Losowy sekret do podpisu ciasteczka sesji, np.: openssl rand -base64 32
# Minimum 32 znaki. Krótszy jest ignorowany i logowanie pozostaje wyłączone.
AUTH_SECRET=
# Adres serwisu (bez ścieżki), na który Google odsyła po zalogowaniu:
# AUTH_URL + /api/auth/callback musi być wpisany w Authorized redirect URIs.
# Na produkcji wymagany. Lokalnie (npm run dev) można zostawić pusty.
AUTH_URL=

# Asystent AI "Zapytaj Samorząd" (/api/asystent). Klucz z console.anthropic.com.
# Bez niego trasa zwraca 503 i UI pokazuje uczciwy komunikat "niedostępne".
ANTHROPIC_API_KEY=

# Adres, spod którego klienci pocztowi pobiorą grafiki stopki (generator w Strefie
# Działacza). Musi wskazywać PRODUKCJĘ — stopka żyje potem w cudzych skrzynkach,
# więc adres podglądu wdrożenia przestałby działać po jego wygaśnięciu.
# Brak zmiennej = https://samorzad.ue.wroc.pl
NEXT_PUBLIC_SIG_BASE=https://samorzad.ue.wroc.pl
